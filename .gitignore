# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python caches ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── SQLite database (runtime-generated; recreate with seed_data.py) ───────
data/*.db
data/*.db-shm
data/*.db-wal

# ── Secrets and environment files ────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets.json
config.secret.*

# ── ML model artifacts (generated; not source code) ──────────────────────
artifacts/*.pkl
artifacts/*.joblib
artifacts/model_evaluation.json

# ── Keep directory stubs tracked ─────────────────────────────────────────
!artifacts/.gitkeep
!data/.gitkeep

# ── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
*.suo
*.user
.idea/

# ── Test / coverage output ────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
