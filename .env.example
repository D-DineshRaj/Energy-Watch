# EnergyWatch — Environment Configuration (3-1 Academic Project 24091A3239)

# Backend Server Listening Port (8082 for local development, dynamic on Render via $PORT)
PORT=8082

# Allowed CORS Origins (comma-separated list for cloud deployment)
# Local development ports (http://localhost:8082, http://localhost:8000, http://localhost:3000) are allowed by default.
CORS_ORIGINS=https://energywatch.vercel.app

# System Reference Date Override (Asia/Kolkata timezone: YYYY-MM-DD)
ENERGYWATCH_CURRENT_DATE=2026-10-31

# SQLite Database Persistence Note:
# SQLite database resides locally at data/energywatch.db.
# On free cloud platforms (Render), the filesystem is ephemeral and resets on restart.
# For persistent cloud deployment, attach a Render Persistent Disk or configure PostgreSQL.

